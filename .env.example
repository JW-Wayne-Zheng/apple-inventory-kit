# Runtime
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Provider: demo uses real nearby Apple Store locations with simulated inventory.
INVENTORY_PROVIDER=demo
APPLE_BASE_URL=https://www.apple.com
APPLE_FULFILLMENT_PATH=/shop/fulfillment-messages
APPLE_GRAPHQL_PATH=/api-www/graphql
APPLE_STORE_SEARCH_QUERY_ID=d95caa379372fe166f35bb89fe8e018e21781c66ee815ee3f68105f36ff4b1d8
APPLE_COUNTRY=US
APPLE_REQUEST_TIMEOUT_SECONDS=8
APPLE_REQUEST_BUDGET_PER_MINUTE=4
POSTAL_LOOKUP_BASE_URL=https://api.zippopotam.us

# Storage and caching
DATABASE_URL=postgresql+asyncpg://inventory:inventory@postgres:5432/inventory
REDIS_URL=redis://redis:6379/0
PERSIST_INVENTORY=true
INVENTORY_CACHE_TTL_SECONDS=30
INVENTORY_STALE_TTL_SECONDS=900
INVENTORY_STREAM_POLL_SECONDS=5
STORE_CACHE_TTL_SECONDS=86400
PRODUCT_CACHE_TTL_SECONDS=21600
REFRESH_LIMIT_REQUESTS=6
REFRESH_LIMIT_WINDOW_SECONDS=60

# Frontend (browser-accessible URL)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
